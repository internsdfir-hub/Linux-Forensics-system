<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LFA Forensic Report - Case {{ summary.case_id }}</title>
  <style>
    {{ inline_css | safe }}
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <h1>Linux Forensic Analysis Report</h1>
        <p style="color: var(--text-secondary);">Case ID: <strong>{{ summary.case_id }}</strong> | Examiner: <strong>{{ summary.examiner }}</strong></p>
      </div>
      <div>
        <span class="badge badge-{{ 'high' if summary.severity_counts.high > 0 else ('medium' if summary.severity_counts.medium > 0 else 'info') }}">
          {{ summary.severity_counts.high }} High / {{ summary.severity_counts.medium }} Med Findings
        </span>
      </div>
    </header>

    <!-- 1. Authorisation, scope & privacy -->
    <section id="sec-auth">
      <h2>1. Authorisation, Scope &amp; Privacy</h2>
      <div class="stat-card">
        <p><strong>Case Reference:</strong> {{ summary.case_id }}</p>
        <p><strong>Examiner:</strong> {{ summary.examiner }}</p>
        <p><strong>Ingest Time:</strong> {{ summary.ingest_time }}</p>
        <p><strong>Target Host(s):</strong> {{ summary.hosts | join(', ') if summary.hosts else 'Host Image' }}</p>
        <p><strong>Privacy / Redaction Notice:</strong> System artifacts collected with strict hash verification. Password hashes and sensitive keys redacted where specified.</p>
      </div>
    </section>

    <!-- 2. Executive Summary -->
    <section id="sec-exec">
      <h2>2. Executive Summary</h2>
      <div class="stat-card">
        <p class="lede">{{ narrative.headline }}</p>

        {% if narrative.key_observations %}
        <h3>Key observations</h3>
        <ul class="observation-list">
          {% for obs in narrative.key_observations %}
          <li>
            <strong>{{ obs.title }}</strong>
            <span>{{ obs.what_happened }}</span>
            <span class="muted">{{ obs.why_it_matters }}</span>
          </li>
          {% endfor %}
        </ul>
        {% endif %}

        {% if narrative.recommended_actions %}
        <h3>Recommended next steps</h3>
        <ol class="action-list">
          {% for step in narrative.recommended_actions %}
          <li>{{ step }}</li>
          {% endfor %}
        </ol>
        {% endif %}
      </div>
    </section>

    <!-- Key Metrics Grid -->
    <div class="grid-stats">
      <div class="stat-card">
        <div class="stat-value">{{ summary.event_count }}</div>
        <div class="stat-label">Total Events Parsed</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" style="color: var(--accent-red);">{{ summary.severity_counts.high }}</div>
        <div class="stat-label">Critical / High Threats</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" style="color: var(--accent-yellow);">{{ summary.severity_counts.medium }}</div>
        <div class="stat-label">Medium Indicators</div>
      </div>
      <div class="stat-card">
        <div class="stat-value">{{ artifacts | length }}</div>
        <div class="stat-label">Artifacts Ingested</div>
      </div>
    </div>

    <!-- 3. Incident Timeline & Activity Density -->
    <section id="sec-timeline">
      <h2>3. Incident Timeline &amp; Activity Density</h2>
      <div style="margin: 20px 0;">
        {{ svg_chart | safe }}
      </div>
      <p style="font-size: 13px; color: var(--text-secondary);">
        Active Window: {{ summary.first_event_utc or 'N/A' }} &mdash; {{ summary.last_event_utc or 'N/A' }}
      </p>
    </section>

    <!-- 4. Findings & Threat Detections -->
    <section id="sec-findings">
      <h2>4. Findings &amp; Threat Detections ({{ findings | length }})</h2>
      {% if not findings %}
        <p style="color: var(--accent-green);">No security findings or correlation threats detected.</p>
      {% endif %}
      {% for f in findings %}
        <div class="finding-card {{ f.severity }}">
          <div class="finding-header">
            <div class="finding-title">{{ f.title }}</div>
            <span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>
          </div>

          <!-- Plain language layer (for management and general readers) -->
          <div class="plain-layer">
            <div class="plain-field"><span class="field-label">What Happened:</span> {{ f.what_happened }}</div>
            <div class="plain-field"><span class="field-label">Why It Matters:</span> {{ f.why_it_matters }}</div>
            <div class="plain-field"><span class="field-label">Confidence:</span> <strong>{{ f.confidence }}</strong></div>
            <div class="plain-field"><span class="field-label">Recommended Action:</span> {{ f.check_next }}</div>
          </div>

          <!-- Technical detail layer (for forensic examiners) -->
          <details>
            <summary>Technical Details &amp; Evidence Provenance (Rule: {{ f.rule_name }} v{{ f.rule_version }})</summary>
            <pre><code>{{ f.technical_detail }}
Associated Event IDs: {{ f.event_ids | join(', ') if f.event_ids else 'State Configuration Finding' }}
Host ID: {{ f.host_id or 'Default' }} | Finding ID: {{ f.finding_id }}</code></pre>
          </details>
        </div>
      {% endfor %}
    </section>

    <!-- 5. Host Inventory & System Configuration -->
    <section id="sec-inventory">
      <h2>5. Host Inventory &amp; System Configuration</h2>
      {% for host_id, meta in summary.hosts_meta.items() %}
        <div class="stat-card" style="margin-bottom: 15px;">
          <h3>Host: {{ host_id }}</h3>
          {% set host_info = meta.collector_manifest.host if meta.collector_manifest else {} %}
          <p><strong>Distro:</strong> {{ host_info.distro_id or 'Linux' }} {{ host_info.version_id or '' }}</p>
          <p><strong>Timezone:</strong> {{ host_info.timezone or 'UTC' }} (Source: {{ host_info.timezone_source or 'default' }})</p>
          <p><strong>Init System:</strong> {{ host_info.init_system or 'systemd' }}</p>
        </div>
      {% endfor %}
    </section>

    <!-- 6. Categorized Forensic Intel -->
    <section id="sec-intel">
      <h2>6. Categorized Forensic Intel</h2>
      <div class="tabs">
        <div class="tab-buttons">
          <button class="tab-btn active" data-target="tab-users">1. User Accounts</button>
          <button class="tab-btn" data-target="tab-logins">2. Login &amp; Sessions</button>
          <button class="tab-btn" data-target="tab-failed-logins">3. Failed Logins</button>
          <button class="tab-btn" data-target="tab-usb">4. USB Activities</button>
          <button class="tab-btn" data-target="tab-storage">5. Storage &amp; Disks</button>
          <button class="tab-btn" data-target="tab-network">6. Network Interfaces</button>
          <button class="tab-btn" data-target="tab-internet">7. Internet &amp; Services</button>
          <button class="tab-btn" data-target="tab-system-additional">8. Additional Features</button>
        </div>

        <!-- Tab 1: User Accounts -->
        <div id="tab-users" class="tab-content active">
          <h3>Local User Accounts</h3>
          <table>
            <thead>
              <tr>
                <th>Username</th>
                <th>First Seen (UTC)</th>
                <th>Account Details &amp; Configuration</th>
              </tr>
            </thead>
            <tbody>
              {% for u in intel.users %}
              <tr>
                <td><strong>{{ u.actor_user }}</strong></td>
                <td><span style="font-family: monospace;">{{ u.first_seen or '-' }}</span></td>
                <td>{{ u.description }}</td>
              </tr>
              {% else %}
              <tr><td colspan="3" style="text-align: center;">No user accounts extracted.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          {% if intel.user_diffs %}
          <h3 style="margin-top: 24px;">User Creation, Deletion &amp; Group Escalations</h3>
          <table>
            <thead>
              <tr>
                <th>Type</th>
                <th>Target User</th>
                <th>Timestamp (UTC)</th>
                <th>Severity</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {% for d in intel.user_diffs %}
              <tr>
                <td><span class="badge badge-info">{{ d.subcategory }}</span></td>
                <td><strong>{{ d.actor_user or '-' }}</strong></td>
                <td><span style="font-family: monospace;">{{ d.timestamp_utc or 'State Diff' }}</span></td>
                <td><span class="badge badge-{{ d.severity }}">{{ d.severity }}</span></td>
                <td>{{ d.description }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}
        </div>

        <!-- Tab 2: Login & Sessions (with calculated duration) -->
        <div id="tab-logins" class="tab-content">
          <h3>Login Sessions &amp; Duration</h3>
          <table>
            <thead>
              <tr>
                <th>Username</th>
                <th>Source IP / Host</th>
                <th>Terminal</th>
                <th>Login Time (UTC)</th>
                <th>Logout Time (UTC)</th>
                <th>Calculated Duration</th>
                <th>Session Status</th>
              </tr>
            </thead>
            <tbody>
              {% for s in intel.sessions %}
              <tr>
                <td><strong>{{ s.actor_user }}</strong></td>
                <td>{{ s.source_ip }}</td>
                <td><code>{{ s.terminal }}</code></td>
                <td><span style="font-family: monospace;">{{ s.login_time }}</span></td>
                <td><span style="font-family: monospace;">{{ s.logout_time }}</span></td>
                <td><strong>{{ s.duration }}</strong></td>
                <td><span class="badge badge-{{ 'low' if s.status == 'Closed' else 'medium' }}">{{ s.status }}</span></td>
              </tr>
              {% else %}
              <tr><td colspan="7" style="text-align: center;">No active or paired login sessions found.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <!-- Tab 3: Failed Login Attempts -->
        <div id="tab-failed-logins" class="tab-content">
          <h3>Failed Login Attempts Aggregation</h3>
          <table>
            <thead>
              <tr>
                <th>Target Username</th>
                <th>Source IP</th>
                <th>Attempts</th>
                <th>First Attempt (UTC)</th>
                <th>Last Attempt (UTC)</th>
              </tr>
            </thead>
            <tbody>
              {% for fl in intel.failed_logins %}
              <tr>
                <td><strong>{{ fl.actor_user or 'UNKNOWN' }}</strong></td>
                <td>{{ fl.source_ip or '-' }}</td>
                <td><span class="badge badge-high">{{ fl.attempt_count }}</span></td>
                <td><span style="font-family: monospace;">{{ fl.first_attempt }}</span></td>
                <td><span style="font-family: monospace;">{{ fl.last_attempt }}</span></td>
              </tr>
              {% else %}
              <tr><td colspan="5" style="text-align: center;">No failed login attempts recorded.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <!-- Tab 4: USB Device Activities -->
        <div id="tab-usb" class="tab-content">
          <h3>USB Hardware Activities</h3>
          <table>
            <thead>
              <tr>
                <th>Timestamp (UTC)</th>
                <th>Action</th>
                <th>Description (Vendor, Model, Serial &amp; Duration)</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {% for u in intel.usb %}
              <tr>
                <td style="white-space: nowrap;"><span style="font-family: monospace;">{{ u.timestamp_utc or '-' }}</span></td>
                <td><span class="badge badge-{{ 'medium' if u.subcategory == 'usb_connect' else 'info' }}">{{ u.subcategory }}</span></td>
                <td>{{ u.description }}</td>
                <td style="font-size: 12px; color: var(--text-secondary);">{{ u.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="4" style="text-align: center;">No USB device activities detected.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <!-- Tab 5: Storage & Hard Disks -->
        <div id="tab-storage" class="tab-content">
          <h3>Connected Storage Devices, Partitions &amp; Mounts</h3>
          <table>
            <thead>
              <tr>
                <th>Type</th>
                <th>Description (Device, Filesystem, Mount Point, UUID &amp; Capacity)</th>
                <th>Metadata / Notes</th>
              </tr>
            </thead>
            <tbody>
              {% for st in intel.storage %}
              <tr>
                <td><span class="badge badge-info">{{ st.subcategory }}</span></td>
                <td>{{ st.description }}</td>
                <td style="font-size: 12px; font-family: monospace;">{{ st.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="3" style="text-align: center;">No disk, partition or mount evidence extracted.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <!-- Tab 6: Network Interfaces -->
        <div id="tab-network" class="tab-content">
          <h3>Network Interfaces &amp; Addressing</h3>
          <table>
            <thead>
              <tr>
                <th>Interface</th>
                <th>Configuration &amp; Addressing (State, MAC, IP/CIDR)</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              {% for ni in intel.network_interfaces %}
              <tr>
                <td><strong>{{ ni.source_ip or ni.subcategory }}</strong></td>
                <td>{{ ni.description }}</td>
                <td style="font-size: 12px; font-family: monospace;">{{ ni.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="3" style="text-align: center;">No network interfaces parsed.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          {% if intel.firewall_network %}
          <h3 style="margin-top: 24px;">Firewall Blocks &amp; Remote Host Connections</h3>
          <table>
            <thead>
              <tr>
                <th>Type</th>
                <th>Timestamp (UTC)</th>
                <th>Source / Target IP</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {% for fn in intel.firewall_network %}
              <tr>
                <td><span class="badge badge-medium">{{ fn.subcategory }}</span></td>
                <td><span style="font-family: monospace;">{{ fn.timestamp_utc or '-' }}</span></td>
                <td>{{ fn.source_ip or '-' }}</td>
                <td>{{ fn.description }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% endif %}

          <h3 style="margin-top: 24px;">Active Volatile Network Connections (ss / netstat)</h3>
          <table>
            <thead>
              <tr>
                <th>State</th>
                <th>Remote IP Address</th>
                <th>Process / PID</th>
                <th>Connection Details (Local -> Remote)</th>
                <th>Evidence Source</th>
              </tr>
            </thead>
            <tbody>
              {% for sock in intel.volatile_sockets %}
              <tr>
                <td><span class="badge badge-{% if sock.subcategory == 'established' %}high{% elif sock.subcategory == 'listen' %}medium{% else %}low{% endif %}">{{ sock.subcategory }}</span></td>
                <td><strong>{{ sock.source_ip or '-' }}</strong></td>
                <td>{{ sock.actor_process or '-' }}</td>
                <td>{{ sock.description }}</td>
                <td style="font-size: 12px; font-family: monospace;">{{ sock.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="5" style="text-align: center;">No active volatile sockets parsed.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <!-- Tab 7: Internet & Network Activities -->
        <div id="tab-internet" class="tab-content">
          <!-- 7a. Remote IP Connections -->
          <h3>Remote IP Connections &amp; Communicating Hosts</h3>
          <table>
            <thead>
              <tr>
                <th>Remote IP Address</th>
                <th>Total Interactions</th>
                <th>Associated Users</th>
                <th>Observed Services</th>
                <th>First Seen (UTC)</th>
                <th>Last Seen (UTC)</th>
              </tr>
            </thead>
            <tbody>
              {% for rip in intel.remote_ips %}
              <tr>
                <td><strong>{{ rip.source_ip }}</strong></td>
                <td><span class="badge badge-info">{{ rip.connection_count }}</span></td>
                <td>{{ rip.users or '-' }}</td>
                <td><span style="font-family: monospace; font-size: 11px;">{{ rip.services }}</span></td>
                <td><span style="font-family: monospace;">{{ rip.first_seen }}</span></td>
                <td><span style="font-family: monospace;">{{ rip.last_seen }}</span></td>
              </tr>
              {% else %}
              <tr><td colspan="6" style="text-align: center;">No external remote IP connections observed.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          <!-- 7b. SSH Connections -->
          <h3 style="margin-top: 28px;">SSH Connections (Inbound &amp; Outbound)</h3>
          <table>
            <thead>
              <tr>
                <th>Timestamp (UTC)</th>
                <th>Direction</th>
                <th>User</th>
                <th>Remote Host / IP</th>
                <th>Event / Subcategory</th>
                <th>Session Details</th>
              </tr>
            </thead>
            <tbody>
              {% for sc in intel.ssh_connections %}
              <tr>
                <td><span style="font-family: monospace;">{{ sc.timestamp_utc or 'Static Key/Host' }}</span></td>
                <td><span class="badge badge-{{ 'medium' if sc.direction == 'Outbound' else 'low' }}">{{ sc.direction }}</span></td>
                <td><strong>{{ sc.actor_user or '-' }}</strong></td>
                <td>{{ sc.source_ip or '-' }}</td>
                <td><code>{{ sc.subcategory }}</code></td>
                <td>{{ sc.description }}</td>
              </tr>
              {% else %}
              <tr><td colspan="6" style="text-align: center;">No SSH connection activities detected.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          <!-- 7c. DNS Requests & Resolvers -->
          <h3 style="margin-top: 28px;">DNS Requests &amp; Resolver Configuration</h3>
          <table>
            <thead>
              <tr>
                <th>Type</th>
                <th>IP / Nameserver</th>
                <th>Hostname / Domain</th>
                <th>Configuration / Resolution Details</th>
                <th>Evidence Source</th>
              </tr>
            </thead>
            <tbody>
              {% for dns in intel.dns_activity %}
              <tr>
                <td><span class="badge badge-info">{{ dns.subcategory }}</span></td>
                <td><strong>{{ dns.source_ip or '-' }}</strong></td>
                <td>{{ dns.source_host or '-' }}</td>
                <td>{{ dns.description }}</td>
                <td style="font-size: 12px; font-family: monospace;">{{ dns.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="5" style="text-align: center;">No DNS resolver or query evidence extracted.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          <!-- 7d. HTTP / HTTPS Logs -->
          <h3 style="margin-top: 28px;">HTTP / HTTPS Web Server Logs</h3>
          <table>
            <thead>
              <tr>
                <th>Timestamp (UTC)</th>
                <th>Client IP</th>
                <th>User</th>
                <th>Request Description</th>
                <th>Status &amp; User-Agent</th>
              </tr>
            </thead>
            <tbody>
              {% for http in intel.http_logs %}
              <tr>
                <td><span style="font-family: monospace;">{{ http.timestamp_utc or '-' }}</span></td>
                <td><strong>{{ http.client_ip or '-' }}</strong></td>
                <td>{{ http.actor_user or '-' }}</td>
                <td>{{ http.description }}</td>
                <td style="font-size: 12px; font-family: monospace;">{{ http.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="5" style="text-align: center;">No HTTP/HTTPS web server requests recorded.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          <!-- 7e. FTP Connections -->
          <h3 style="margin-top: 28px;">FTP Connections &amp; File Transfers</h3>
          <table>
            <thead>
              <tr>
                <th>Timestamp (UTC)</th>
                <th>Client IP</th>
                <th>User</th>
                <th>Transfer / Action</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              {% for ftp in intel.ftp_connections %}
              <tr>
                <td><span style="font-family: monospace;">{{ ftp.timestamp_utc or '-' }}</span></td>
                <td><strong>{{ ftp.client_ip or '-' }}</strong></td>
                <td>{{ ftp.actor_user or '-' }}</td>
                <td>{{ ftp.description }}</td>
                <td style="font-size: 12px; font-family: monospace;">{{ ftp.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="5" style="text-align: center;">No FTP transfer or session logs detected.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          <!-- 7f. Browser Activities & Download History -->
          <h3 style="margin-top: 28px;">Browser Activities &amp; Download History</h3>
          <table>
            <thead>
              <tr>
                <th>Timestamp (UTC)</th>
                <th>Type</th>
                <th>User</th>
                <th>Activity Description / URL</th>
                <th>Target File / Notes</th>
              </tr>
            </thead>
            <tbody>
              {% for b in intel.browser_and_downloads %}
              <tr>
                <td><span style="font-family: monospace;">{{ b.timestamp_utc or '-' }}</span></td>
                <td><span class="badge badge-info">{{ b.subcategory }}</span></td>
                <td><strong>{{ b.actor_user or '-' }}</strong></td>
                <td>{{ b.description }}</td>
                <td style="font-size: 12px; font-family: monospace;">{{ b.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="5" style="text-align: center;">No browser history or download events recorded.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <!-- Tab 8: Additional Features -->
        <div id="tab-system-additional" class="tab-content">
          <h3>Security &amp; Persistence Activities (Cron, Sudo, Commands, Services)</h3>
          <table>
            <thead>
              <tr>
                <th>Category</th>
                <th>Subcategory</th>
                <th>User</th>
                <th>Timestamp (UTC)</th>
                <th>Severity</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {% for sa in intel.system_additional %}
              <tr>
                <td><span class="badge badge-info">{{ sa.category }}</span></td>
                <td>{{ sa.subcategory }}</td>
                <td><strong>{{ sa.actor_user or '-' }}</strong></td>
                <td><span style="font-family: monospace;">{{ sa.timestamp_utc or '-' }}</span></td>
                <td><span class="badge badge-{{ sa.severity }}">{{ sa.severity }}</span></td>
                <td>{{ sa.description }}</td>
              </tr>
              {% else %}
              <tr><td colspan="6" style="text-align: center;">No additional security events recorded.</td></tr>
              {% endfor %}
            </tbody>
          </table>

          <h3 style="margin-top: 24px;">Interactive Shell History</h3>
          <table>
            <thead>
              <tr>
                <th>Timestamp (UTC)</th>
                <th>User</th>
                <th>Command Executed</th>
                <th>Severity</th>
                <th>Evidence Source</th>
              </tr>
            </thead>
            <tbody>
              {% for sh in intel.shell_history %}
              <tr>
                <td><span style="font-family: monospace;">{{ sh.timestamp_utc or 'Unknown' }}</span></td>
                <td><strong>{{ sh.actor_user or '-' }}</strong></td>
                <td style="font-family: monospace;">{{ sh.description }}</td>
                <td><span class="badge badge-{{ sh.severity }}">{{ sh.severity }}</span></td>
                <td style="font-size: 12px; font-family: monospace;">{{ sh.notes or '-' }}</td>
              </tr>
              {% else %}
              <tr><td colspan="5" style="text-align: center;">No interactive shell history extracted.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 7. Detailed Event Timeline -->
    <section id="sec-events">
      <h2>7. Normalized Event Timeline (Sample)</h2>
      <div class="filter-bar">
        <input type="text" id="event-filter" class="search-input" placeholder="Search events by user, IP, process, category or description...">
      </div>
      <table id="events-table">
        <thead>
          <tr>
            <th>Timestamp (UTC)</th>
            <th>Category</th>
            <th>Severity</th>
            <th>Actor</th>
            <th>Source IP</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {% for ev in events %}
            <tr>
              <td style="white-space: nowrap; font-family: monospace;">{{ ev.timestamp_utc or 'State Finding' }}</td>
              <td><span class="badge badge-info">{{ ev.category }}</span></td>
              <td><span class="badge badge-{{ ev.severity }}">{{ ev.severity }}</span></td>
              <td>{{ ev.actor_user or '-' }}</td>
              <td>{{ ev.source_ip or '-' }}</td>
              <td>{{ ev.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <!-- 8. Evidence Integrity & Chain of Custody -->
    <section id="sec-integrity">
      <h2>8. Evidence Integrity &amp; Chain of Custody</h2>
      <table>
        <thead>
          <tr>
            <th>Artifact Path</th>
            <th>SHA-256 (Collection)</th>
            <th>SHA-256 (Ingest)</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {% for a in artifacts %}
            <tr>
              <td><code>{{ a.original_path }}</code></td>
              <td style="font-family: monospace; font-size: 11px;">{{ a.sha256_at_collect[:16] }}...</td>
              <td style="font-family: monospace; font-size: 11px;">{{ a.sha256_at_ingest[:16] if a.sha256_at_ingest else 'N/A' }}...</td>
              <td>
                {% if a.quarantined %}
                  <span class="badge badge-high">QUARANTINED</span>
                {% elif a.status == 'ok' %}
                  <span class="badge badge-low">VERIFIED</span>
                {% else %}
                  <span class="badge badge-info">{{ a.status }}</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <!-- 9. Methodology, Limitations & Tool Audit -->
    <section id="sec-methodology">
      <h2>9. Methodology, Limitations &amp; Tool Audit</h2>
      <div class="stat-card">
        <p><strong>Forensic Compliance:</strong> Ingestion and correlation executed strictly against the frozen RFC 3227 Order of Volatility model and unified event schema.</p>
        <p><strong>Deterministic Guarantee:</strong> Generated using zero-dependency deterministic engines with byte-stable hashing.</p>
        <p><strong>Offline Execution:</strong> Verified zero external network references or third-party web font calls.</p>
      </div>
    </section>

    <!-- 10. Glossary -->
    <section id="sec-glossary">
      <h2>10. Glossary of Forensic Terms</h2>
      <div class="stat-card">
        <p><strong>NormalizedEvent:</strong> Unified event schema consolidating heterogeneous Linux logs into standardized time, actor, source, and severity fields.</p>
        <p><strong>wtmp / btmp:</strong> Binary login and failure accounting records maintained by Linux libc / utmp subsystems.</p>
        <p><strong>Order of Volatility:</strong> Standard evidence preservation hierarchy defined in RFC 3227 (registers/cache &rarr; RAM &rarr; state/sockets &rarr; disk &rarr; backups).</p>
      </div>
    </section>
  </div>

  <script>
    {{ inline_js | safe }}
  </script>
</body>
</html>
