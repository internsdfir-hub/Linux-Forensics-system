<section id="sec-evidence" aria-labelledby="h-evidence">
  <h2 id="h-evidence">Evidence</h2>

  <h3>Host inventory</h3>
  <p class="muted">Distro, kernel and timezone as reported by the collector at
     acquisition time. The timezone and its source matter: some timestamps in
     this report were reconstructed and carry a confidence of
     <em>year_inferred</em> &mdash; see Appendix B.</p>

  <div class="table-scroll">
    <table class="data-table" data-sortable>
      <thead>
        <tr>
          <th scope="col" data-sort="text">Host</th>
          <th scope="col" data-sort="text">Hostname</th>
          <th scope="col" data-sort="text">Distro</th>
          <th scope="col" data-sort="text">Kernel</th>
          <th scope="col" data-sort="text">Init system</th>
          <th scope="col" data-sort="text">Timezone</th>
        </tr>
      </thead>
      <tbody>
        {% for host_id, host_meta in summary.hosts_meta.items() %}
        {% set host = host_meta.get('collector_manifest', {}).get('host', {}) %}
        <tr>
          <td class="mono">{{ host_id }}</td>
          <td>{{ host.get('hostname') or '—' }}</td>
          <td>
            {{ host.get('pretty_name') or host.get('distro_id') or '—' }}
            {%- if host.get('version_id') %} {{ host.get('version_id') }}{% endif %}
          </td>
          <td class="mono">{{ host.get('kernel') or '—' }}</td>
          <td>{{ host.get('init_system') or '—' }}</td>
          <td>
            {{ host.get('timezone') or '—' }}
            {%- if host.get('timezone_source') %} ({{ host.get('timezone_source') }}){% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h3>Artifacts collected</h3>
  <p class="muted">{{ artifacts | length }} artifact(s). Integrity is the hash
     recorded at collection compared against the hash recomputed at ingest.</p>

  <div class="table-scroll">
    <table class="data-table" data-sortable>
      <thead>
        <tr>
          <th scope="col" data-sort="text">Path</th>
          <th scope="col" data-sort="text">Host</th>
          <th scope="col" data-sort="number">Size</th>
          <th scope="col" data-sort="text">Hash at collection</th>
          <th scope="col" data-sort="text">Hash at ingest</th>
          <th scope="col" data-sort="text">Integrity</th>
          <th scope="col" data-sort="text">Parsed</th>
        </tr>
      </thead>
      <tbody>
        {% for a in artifacts %}
        <tr>
          <td class="mono">{{ a.original_path }}</td>
          <td>{{ a.host_id }}</td>
          <td class="num">{{ a.size if a.size is not none else '—' }}</td>
          <td class="mono" title="{{ a.sha256_at_collect or '' }}">
            {{ a.sha256_at_collect[:16] if a.sha256_at_collect else '—' }}
          </td>
          <td class="mono" title="{{ a.sha256_at_ingest or '' }}">
            {{ a.sha256_at_ingest[:16] if a.sha256_at_ingest else '—' }}
          </td>
          <td>
            <span class="state state--{{ a.integrity or 'unknown' }}">
              {{ a.integrity or 'unknown' }}
            </span>
          </td>
          <td>
            <span class="state state--{{ a.parse_status or 'unknown' }}">
              {{ a.parse_status or 'unknown' }}
            </span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <figure class="chart">
    {{ user_chart | safe }}
    <figcaption>Recorded activity per account.</figcaption>
  </figure>
</section>
