[Unit]
Description=Deploy webhook receiver
Documentation=https://example.internal/docs/webhook
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
ExecStartPre=/usr/bin/test -x /opt/webhook/bin/webhook
ExecStart=/opt/webhook/bin/webhook \
    -config /etc/webhook.yml \
    -verbose
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
